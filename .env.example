# Local demo: acknowledges submissions without storing them or contacting AWS.
PORT=3000
FEEDBACK_MODE=demo

# MOCK VALUES — replace before switching FEEDBACK_MODE to sns.
AWS_REGION=eu-west-2
SNS_TOPIC_ARN=arn:aws:sns:eu-west-2:123456789012:footielineup-feedback
# Optional for local access keys; leave unset when using an AWS profile or IAM role.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
# Only needed for temporary STS credentials; otherwise leave blank.
# AWS_SESSION_TOKEN=REPLACE_ME
